{
    "extends": "stylelint-config-standard",
    "rules": {
        "import-notation": "string",
        "at-rule-no-unknown": [
            true,
            {
                "ignoreAtRules": [
                    "apply",
                    "config",
                    "custom-variant",
                    "plugin",
                    "reference",
                    "source",
                    "theme",
                    "utility",
                    "variant"
                ]
            }
        ]
    }
}
